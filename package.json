{
  "name": "openscp",
  "productName": "OpenSCP",
  "version": "0.3.4",
  "private": true,
  "license": "MIT",
  "author": "OpenSCP contributors",
  "homepage": "https://github.com/alex-thrice/open-scp",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-thrice/open-scp.git"
  },
  "bugs": "https://github.com/alex-thrice/open-scp/issues",
  "description": "Cross-platform desktop file client",
  "main": "./out/main/index.js",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.18.1 <25"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "node scripts/package.mjs",
    "package:win": "node scripts/package.mjs --win",
    "package:linux": "node scripts/package.mjs --linux",
    "package:mac": "node scripts/package.mjs --mac",
    "package:signed": "node scripts/package.mjs --signed",
    "icons": "node scripts/generate-icons.mjs",
    "licenses:check": "node scripts/generate-license-notices.mjs",
    "test:packaging": "node --test tests/packaging/*.test.mjs",
    "test:packaged": "playwright test tests/e2e/packaged-smoke.spec.ts",
    "lint": "eslint . && prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:integration": "pnpm build && node tests/fixtures/run-e2e.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "fixtures:up": "node tests/fixtures/environment.mjs up",
    "fixtures:wait": "node tests/fixtures/environment.mjs wait",
    "fixtures:down": "node tests/fixtures/environment.mjs down",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1126.0",
    "basic-ftp": "6.2.1",
    "electron-updater": "6.8.9",
    "i18next": "26.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "ssh2": "1.17.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/ssh2": "1.15.6",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.9.1",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
